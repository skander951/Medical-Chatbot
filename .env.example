# ---------- Ollama (local, free) ----------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=4096

# Optional: use a different local model per agent
# (small/fast for routing, bigger for the final answer)
# ONBOARDING_MODEL=llama3.2:3b
# ORCHESTRATOR_MODEL=llama3.2:3b
# DISEASE_MODEL=llama3.1:8b
# MEDICINE_MODEL=llama3.1:8b
# RESPONSE_MODEL=qwen2.5:7b

# ---------- RAG ----------
TOP_K=4
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
DATA_DIR=data
PERSIST_DIR=vectorstore

# ---------- LangSmith (tracing, latency, evaluation) ----------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=medical-multi-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
